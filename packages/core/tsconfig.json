{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "//": "Tests and the fixtures they share are typechecked (see tsconfig.test.json) but never emitted.",
  "exclude": ["src/**/*.test.ts", "src/**/*.testkit.ts"]
}
