{
  "name": "catan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Catan — rules-faithful TypeScript implementation with a GUI and multiplayer",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @catan/client",
    "build": "tsc --build && npm run build --workspace @catan/client",
    "typecheck": "tsc --build --force && tsc -p packages/core/tsconfig.test.json && tsc -p packages/client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "fast-check": "^4.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
